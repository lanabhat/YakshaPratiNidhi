# Copy to .env (git-ignored) and fill in. Read by the API (run_api.ps1) and the intake app.

# --- shared by the intake app (publisher) and the API -------------------------
# Where the API lives. Local dev: the Flask app. Production: your PythonAnywhere URL.
API_BASE_URL=http://127.0.0.1:8200
# Secret only the intake app and the API know; the browser never sees it.
INGEST_API_KEY=change-me

# --- image storage: "local" (dev, no accounts) or "supabase" ------------------
STORAGE_BACKEND=local
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=<service role key - keep secret>
# SUPABASE_BUCKET=lipisampada

# --- API sign-in ---------------------------------------------------------------
# dev = token "dev:<email>" trusted as-is (local development ONLY).
# firebase = Google sign-in via Firebase; then also set FIREBASE_PROJECT_ID and
#            pip install pyjwt cryptography
AUTH_MODE=dev
# FIREBASE_PROJECT_ID=
# Emails made superadmin on first sign-in (bootstrap), comma separated.
SUPERADMIN_EMAILS=you@example.com
# Browser origins allowed to call the API (your Firebase Hosting URL in production).
CORS_ORIGINS=*
